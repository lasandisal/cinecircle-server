# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Neon, Supabase, or Local PostgreSQL)
# Example: postgresql://username:password@ep-something.region.neon.tech/cinecircle?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cinecircle?schema=public"

# MongoDB Connection String (Atlas or Local)
# Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cinecircle?retryWrites=true&w=majority
# Local: mongodb://admin:1234@localhost:27017/cinecircle?authSource=admin
MONGODB_URI=mongodb://admin:1234@localhost:27017/cinecircle?authSource=admin


# JWT Authentication Secrets
# The API refuses to boot if JWT_SECRET is missing or a known placeholder.
JWT_SECRET=supersecretjwtkey_cinecircle_change_in_production
JWT_EXPIRES_IN=7d

# Session cookie (HttpOnly). Production uses SameSite=None + Secure because
# the client and API live on different sites; development uses SameSite=Lax.
AUTH_COOKIE_NAME=cinecircle_token

# One-time email codes expire after this many minutes.
OTP_TTL_MINUTES=10

# CORS / WebSocket allowed origin
CLIENT_URL=http://localhost:5173
# Extra origins (comma separated), e.g. Vercel preview deployments.
# Wildcards and blanket suffixes are intentionally not supported.
ALLOWED_ORIGINS=

# Supabase Storage (server-side uploads only)
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret/service key. NEVER expose this to the frontend and never prefix it
# with VITE_.
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_STORAGE_BUCKET=cinecircle-images

# Shared rate-limit counters (Upstash Redis REST API)
# Optional locally, required for correct limits on Vercel: without it every
# serverless instance keeps its own counters, so the effective limit is
# (configured limit x number of instances). Create a database at
# https://console.upstash.com and copy the REST URL and REST token here.
# Vercel's Upstash integration exports KV_REST_API_URL / KV_REST_API_TOKEN,
# which are also accepted. Leave blank to fall back to in-memory counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# External TMDB API Key
TMDB_API_KEY=your_tmdb_api_key_here

# Google Gemini AI API Key (Get free from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

